# Chat / retrieval
GROQ_API_KEY=gsk_...
GOOGLE_API_KEY=AIza...

# OpenUI Gateway — answer generation (generative UI). Mint with:
#   npx @openuidev/cli@latest generate-api-key
THESYS_API_KEY=
# Any Gateway model id ({provider}/{model}); free Gemini variants need no paid plan.
GATEWAY_MODEL=google/gemini-3.6-flash-free

# Database (Neon Postgres)
DATABASE_URL=postgresql://user:pass@ep-...neon.tech/neondb?sslmode=require
AUTH_SECRET=generate-one-with-openssl-rand-base64-32

# OAuth (optional; button appears when the pair is set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
